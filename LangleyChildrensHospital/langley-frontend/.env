# ==============================================================================
# Langley Children's Hospital Environment Properties
# In Vite, client-exposed variables MUST begin with the `VITE_` prefix.
# ==============================================================================

# Regional Backend REST API Base URL (Spring Boot Port 8081)
VITE_API_BASE_URL=http://localhost:8081/api

# Inbound Mirth sync background polling interval in milliseconds
VITE_POLLING_INTERVAL_MS=8000

# Hospital Regional Application Name
VITE_APP_TITLE=Langley Children's Hospital
