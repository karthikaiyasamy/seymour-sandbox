{
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "java",
            "name": "Launch SeymorFHIR (Spring Boot)",
            "request": "launch",
            "mainClass": "com.healthcare.sandbox.HealthcareSandboxApplication",
            "projectName": "seymor-fhir"
        },
        {
            "type": "java",
            "name": "Launch Langley Backend (Spring Boot)",
            "request": "launch",
            "mainClass": "com.langley.hospital.LangleyBackendApplication",
            "projectName": "langley-backend"
        },
        {
            "type": "chrome",
            "name": "Launch Langley Frontend (Chrome)",
            "request": "launch",
            "url": "http://localhost:8082",
            "webRoot": "${workspaceFolder}/LangleyChildrensHospital/langley-frontend",
            "preLaunchTask": "Start Langley Frontend"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Stop All Services",
            "runtimeExecutable": "echo",
            "runtimeArgs": ["Services stopped successfully!"],
            "preLaunchTask": "Stop All Services"
        }
    ],
    "compounds": [
        {
            "name": "Launch All Services",
            "configurations": [
                "Launch SeymorFHIR (Spring Boot)",
                "Launch Langley Backend (Spring Boot)",
                "Launch Langley Frontend (Chrome)"
            ]
        }
    ]
}