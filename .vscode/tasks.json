{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start SeymorFHIR Backend",
            "type": "shell",
            "command": "mvn spring-boot:run",
            "options": {
                "cwd": "${workspaceFolder}/SeymorFHIR"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Start Langley Backend",
            "type": "shell",
            "command": "mvn spring-boot:run",
            "options": {
                "cwd": "${workspaceFolder}/LangleyChildrensHospital/langley-backend"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Start Langley Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/LangleyChildrensHospital/langley-frontend"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Start All Services",
            "dependsOn": [
                "Start SeymorFHIR Backend",
                "Start Langley Backend",
                "Start Langley Frontend"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
